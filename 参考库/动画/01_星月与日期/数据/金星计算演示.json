    "target_equatorial_unit_vector": "s = (cos(delta)*cos(alpha), cos(delta)*sin(alpha), sin(delta))",
    "zenith_equatorial_unit_vector": "z = (cos(phi)*cos(theta), cos(phi)*sin(theta), sin(phi))",
    "east_basis_equatorial": "e = (-sin(theta), cos(theta), 0)",
    "north_basis_equatorial": "n = (-sin(phi)*cos(theta), -sin(phi)*sin(theta), cos(phi))",
    "up": "U = s dot z = sin(phi)*sin(delta) + cos(phi)*cos(delta)*cos(H)",
    "altitude": "h = asin(U)",
    "east": "E = s dot e = -cos(delta)*sin(H)",
    "north": "N = s dot n = cos(phi)*sin(delta) - sin(phi)*cos(delta)*cos(H)",
    "azimuth": "A = atan2(E,N) mod 360 degrees",
    "az_alt_to_enu": "(E,N,U) = (cos(h)*sin(A), cos(h)*cos(A), sin(h))",
