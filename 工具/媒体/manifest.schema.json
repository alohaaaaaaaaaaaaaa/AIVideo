{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/aziya/film-v1.schema.json",
  "title": "啊子牙工作室 manifest v1",
  "type": "object",
  "required": [
    "shots",
    "audio"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string"
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60,
      "default": 25
    },
    "width": {
      "type": "integer",
      "minimum": 2,
      "multipleOf": 2,
      "default": 1920
    },
    "height": {
      "type": "integer",
      "minimum": 2,
      "multipleOf": 2,
      "default": 1080
    },
    "output_dir": {
      "type": "string",
      "default": "导出"
    },
    "crf": {
      "type": "integer",
      "minimum": 0,
      "maximum": 51
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "duration",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "path": {
            "type": "string"
          },
          "in": {
            "type": "number",
            "minimum": 0,
            "default": 0
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "kind": {
            "enum": [
              "image",
              "video",
              "ai",
              "animation"
            ]
          },
          "native_label": {
            "type": "boolean",
            "default": false
          },
          "source_note": {
            "type": "string"
          },
          "speed": {
            "const": 1
          },
          "loop": {
            "const": false
          },
          "watermark_position": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "source_note_safe_area": {
            "type": "boolean",
            "description": "fullframe补底注前人工确认底部来源区域无需保留正文"
          },
          "layout": {
            "type": "object",
            "properties": {
              "mode": {
                "enum": [
                  "fullframe",
                  "contain",
                  "evidence_region"
                ],
                "default": "fullframe"
              },
              "reason": {
                "type": "string"
              },
              "crop": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "integer"
                }
              },
              "destination": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "integer"
                }
              }
            }
          },
          "subtitle_style": {
            "$ref": "#/properties/subtitle_style"
          },
          "expected_sha256": {
            "$ref": "#/$defs/sha256",
            "description": "导演编译时审定的素材哈希；同名换版必须重编译"
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "expected_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "导演编译时审定的全片混音哈希"
        }
      }
    },
    "subtitles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start",
          "end",
          "text"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "style": {
            "$ref": "#/properties/subtitle_style"
          }
        }
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start",
          "title"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "subtitle_style": {
      "type": "object",
      "properties": {
        "font": {
          "type": "string"
        },
        "font_size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "margin_v": {
          "type": "number",
          "minimum": 0
        },
        "profile": {
          "enum": [
            "main",
            "science"
          ]
        }
      }
    },
    "watermark": {
      "$ref": "#/$defs/watermark"
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "watermark"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "label": {
            "type": "string"
          },
          "watermark": {
            "type": "boolean"
          },
          "watermark_path": {
            "type": "string"
          },
          "watermark_override": {
            "$ref": "#/$defs/watermark"
          }
        }
      }
    },
    "editorial_binding": {
      "type": "object",
      "required": [
        "plan_path",
        "plan_sha256",
        "timeline_path",
        "timeline_sha256"
      ],
      "properties": {
        "plan_path": {
          "type": "string",
          "minLength": 1,
          "description": "相对manifest目录的路径"
        },
        "plan_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "timeline_path": {
          "type": "string",
          "minLength": 1,
          "description": "相对manifest目录的路径"
        },
        "timeline_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "visual_cues_path": {
          "type": "string",
          "minLength": 1,
          "description": "相对manifest目录的路径"
        },
        "visual_cues_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "narration_path": {
          "type": "string",
          "minLength": 1,
          "description": "相对manifest目录的路径"
        },
        "narration_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "dependentRequired": {
        "visual_cues_path": [
          "visual_cues_sha256"
        ],
        "visual_cues_sha256": [
          "visual_cues_path"
        ],
        "narration_path": [
          "narration_sha256"
        ],
        "narration_sha256": [
          "narration_path"
        ]
      }
    }
  },
  "$defs": {
    "watermark": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "opacity": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "editorial_binding"
        ]
      },
      "then": {
        "properties": {
          "shots": {
            "items": {
              "required": [
                "expected_sha256"
              ]
            }
          },
          "audio": {
            "required": [
              "expected_sha256"
            ]
          }
        }
      }
    }
  ]
}
